# ============================================================
# FireWatch AI — секреты. Скопируй в .env и заполни.
#   cp .env.example .env
# Файл .env в git НЕ коммитится (см. .gitignore).
# ============================================================

# --- Telegram-бот для алертов ---
# 1) Создай бота у @BotFather -> получишь токен.
# 2) Напиши боту любое сообщение, затем узнай chat_id
#    (например через https://api.telegram.org/bot<ТОКЕН>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Необязательно ---
# Путь к config.yaml, если он не в корне проекта.
# FIREWATCH_CONFIG=config.yaml
