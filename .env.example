# ============================================================
# FireWatch AI — secrets. Copy to .env and fill in.
#   cp .env.example .env
# The .env file is NOT committed to git (see .gitignore).
# ============================================================

# --- Telegram bot for alerts ---
# 1) Create a bot via @BotFather to get a token.
# 2) Send the bot any message, then look up your chat_id
#    (e.g. via https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional ---
# Path to config.yaml if it is not in the project root.
# FIREWATCH_CONFIG=config.yaml
